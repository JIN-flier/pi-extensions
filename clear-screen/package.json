{
  "name": "clear-command",
  "private": true,
  "version": "1.0.0",
  "description": "Pi extension providing /clear and /history commands",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "pi -e ./src/index.ts",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
